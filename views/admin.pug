extends layout

block content
  h1 Admin

  - var selectedImages = images.filter(img => img.selected)
  if selectedImages.length > 0
    .selected-photos-section
      .selected-photos-container
        each image in selectedImages
          .selected-photo-item(data-selected='true')
            a(href=`/images/${image.filename}`)
              img(src=`/images/${image.filename}` alt=image.filename)
            label.checkbox-label
              input(type='checkbox' data-filename=image.filename checked=image.selected)
              span Select

  .gallery
    each image in images
      .gallery-item(data-selected=image.selected ? 'true' : 'false')
        a(href=`/images/${image.filename}`)
          img(src=`/images/${image.filename}` alt=image.filename)
        label.checkbox-label
          input(type='checkbox' data-filename=image.filename checked=image.selected)
          span Select

  script.
    document.addEventListener('DOMContentLoaded', () => {
      const checkboxes = document.querySelectorAll('input[type="checkbox"]');

      checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', async (e) => {
          const filename = e.target.getAttribute('data-filename');
          const selected = e.target.checked;
          const photoItem = e.target.closest('.gallery-item') || e.target.closest('.selected-photo-item');

          try {
            const response = await fetch(`/api/photos/${filename}`, {
              method: 'PATCH',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({ selected }),
            });

            if (response.ok) {
              const allItemsForPhoto = document.querySelectorAll(`[data-filename="${filename}"]`);
              allItemsForPhoto.forEach(item => {
                const itemContainer = item.closest('.gallery-item') || item.closest('.selected-photo-item');
                if (itemContainer) {
                  itemContainer.setAttribute('data-selected', selected ? 'true' : 'false');
                }
                item.checked = selected;
              });

              if (!selected && photoItem.classList.contains('selected-photo-item')) {
                photoItem.remove();
              }
            } else {
              e.target.checked = !selected;
              alert('Failed to update selection');
            }
          } catch (error) {
            e.target.checked = !selected;
            alert('Failed to update selection');
          }
        });
      });
    });